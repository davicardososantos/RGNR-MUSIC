# Supabase — painel do projeto > Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ⚠️ SÓ SERVIDOR. Nunca importar em componente client.
# O schema roda com RLS deny-all: esta é a única chave que lê algo.
SUPABASE_SERVICE_ROLE_KEY=

# Usado no callback do magic link
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Protege a rota de ping semanal (free tier do Supabase pausa projeto inativo)
CRON_SECRET=
